{
  "description": "JEV 派单审核：PreToolUse 拦截违规派单，PostToolUse 交付 warn 观察模式提示（CodeBuddy Code 与 Claude Code 共用）",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Task|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/jev-hook pre",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Task|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/jev-hook post",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
